COMPOSE_PROJECT_NAME=icloud-mail
ICLOUD_API_PORT=8788
ICLOUD_API_IMAPS_PORT=1993
# Set before first startup; existing installations must also migrate keys/admin-path.
ICLOUD_API_ADMIN_PATH=/admin
ICLOUD_API_PUBLIC_IMAP_SERVER_NAME=localhost
# Share IDLE notifications and incremental reads for active accounts.
ICLOUD_API_IMAP_IDLE_ENABLED=true
# Wake shared receivers on pickup; idle accounts sleep without periodic polling.
ICLOUD_API_MAIL_ON_DEMAND_ONLY=true
# Return the latest OTP object; no messages still returns [].
ICLOUD_API_OTP_RETURN_LATEST_ONLY=true
# Legacy background-mode fallback, not the active on-demand freshness window.
ICLOUD_API_IMAP_FALLBACK_INTERVAL=15m
DOCKER_HUB_MIRROR=docker.io
GOPROXY=https://proxy.golang.org,direct
NPM_REGISTRY=https://registry.npmjs.org
ALPINE_MIRROR=dl-cdn.alpinelinux.org

# Public HTTPS/IMAPS deployment: see docs/PUBLIC.md before enabling.
# COMPOSE_FILE=compose.yaml:compose.public.yaml
# ICLOUD_API_COOKIE_SECURE=true
# ICLOUD_API_PUBLIC_IMAP_TLS_CERT_FILE=/app/public-tls/fullchain.pem
# ICLOUD_API_PUBLIC_IMAP_TLS_KEY_FILE=/app/public-tls/privkey.pem
# Set this to the actual proxy address or Docker bridge gateway for your host.
# ICLOUD_API_TRUSTED_PROXIES=192.0.2.1/32
